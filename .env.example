OPENAI_API_KEY=sk-...

# Production: leave empty (Nginx same-origin proxying, no CORS needed)
# Dev override: comma-separated origins
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Model migration defaults (exported variables take precedence)
OPENAI_MODEL=gpt-6-sol
OPENAI_REASONING_EFFORT=none
OPENAI_WEB_REASONING_EFFORT=low
