OPENAI_API_KEY=your_openai_api_key_here

# OpenAI model to use (default: gpt-4o)
# OPENAI_MODEL=gpt-4o

# URL of the running orchestration service.
# Docker Desktop (Mac/Windows): http://host.docker.internal:8000
# Linux Docker:                  http://172.17.0.1:8000
# Local dev (no Docker):         http://localhost:8000
ORCHESTRATION_URL=http://host.docker.internal:8000

# Production: leave empty (Nginx same-origin proxying, no CORS needed)
# Dev override: comma-separated origins
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174
